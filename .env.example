PAPERLESS_TOKEN=replace-me
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
PAPERLESS_VERIFY_SSL=true
PAPERLESS_TIMEOUT_SECONDS=60
PAPERLESS_TASK_POLL_SECONDS=2
PAPERLESS_TASK_TIMEOUT_SECONDS=300
TRANSLATION_BATCH_CHARS=4000
TRANSLATION_BATCH_ITEMS=12
PDF2ZH_COMMAND=pdf2zh_next
PDF2ZH_SOURCE_LANGUAGE=
PDF2ZH_WATERMARK_OUTPUT_MODE=no_watermark
PDF2ZH_TIMEOUT_SECONDS=1800
TEMP_DIR=/tmp/paperlaas-translate
